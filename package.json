{
  "name": "chatdacs",
  "version": "4.0.0-alpha.1",
  "decription": "Chatbot: shaDiao Ai Chat System",
  "license": "GPL-3.0",
  "scripts": {
    "check:syntax": "node scripts/check-syntax.js",
    "ci:verify": "npm run check:syntax && npm run test:ci",
    "dev": "node index.js",
    "smoke:web": "node scripts/verify-release.js",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "verify:release": "npm run ci:verify && npm run smoke:web",
    "package:release": "node scripts/build-release.js",
    "pkg": "npm run package:release",
    "docker-build": "docker build . -t giftina/chatdacs:",
    "migrate-generate": "npx sequelize-cli migration:generate --name",
    "migrate-dev": "npx sequelize-cli db:migrate",
    "migrate": "npx sequelize-cli db:migrate --env production",
    "migrate:undo": "npx sequelize-cli db:migrate:undo --env production",
    "inject": "node --experimental-sea-config sea-config.json && npx postject chatdacs.exe NODE_SEA_BLOB chatdacs.blob --sentinel-fuse NODE_SEA_FUSE_fce680ab2cc467b6e072b8b5df1996b2 --overwrite"
  },
  "dependencies": {
    "axios": "0.30.1",
    "bilibili-live-ws": "6.3.1",
    "canvas": "^2.11.2",
    "colors": "1.4.0",
    "compression": "1.8.1",
    "cookie": "1.0.2",
    "dayjs": "1.11.13",
    "diff": "7.0.0",
    "express": "5.1.0",
    "lib-qqwry": "1.3.4",
    "mp3-duration": "1.1.0",
    "multer": "1.4.4",
    "node-schedule": "2.1.1",
    "node-telegram-bot-api": "0.66.0",
    "nodejs-jieba": "0.3.0",
    "play-sound": "1.1.6",
    "qq-guild-bot": "2.9.5",
    "request": "2.88.2",
    "require.all": "2.0.5",
    "rss-parser": "3.13.0",
    "select-random-file": "1.2.4",
    "semver-diff": "3.1.1",
    "sequelize": "6.37.7",
    "sharp": "0.34.3",
    "socket.io": "4.8.1",
    "sqlite3": "5.1.7",
    "trayicon": "1.2.2",
    "wallpaper": "5.0.1",
    "winston": "3.17.0",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "archiver": "7.0.1",
    "eslint": "9.33.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-n": "14.0.0",
    "sequelize-cli": "^6.5.2",
    "jest": "^29.7.0"
  },
  "repository": {
    "type": "git",
    "url": "//github.com/Giftia/ChatDACS.git"
  },
  "bin": "index.js",
  "engines": {
    "node": "18.20.8"
  }
}
